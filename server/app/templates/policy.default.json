{
  "version": 3,
  "project": {
    "name": "",
    "root": ""
  },
  "defaultMode": "manual",
  "saved": null,
  "modes": [
    {
      "id": "manual",
      "name": "수동제어",
      "desc": "모든 의사결정을 내가 직접 승인해요."
    },
    {
      "id": "error",
      "name": "오류 대응 자동화",
      "desc": "실험 중 생긴 에러 수정만 AI가 처리해요."
    },
    {
      "id": "full",
      "name": "연구 전체 자동화",
      "desc": "결과 판단과 다음 실험 결정까지 AI가 하고, 종료 조건에서 멈춰요."
    }
  ],
  "actions": [
    {
      "key": "code",
      "name": "코드 수정",
      "desc": "실험 코드·설정 파일 · 수정 전 자동 커밋",
      "defaults": {
        "manual": "ask",
        "error": "allow",
        "full": "allow"
      },
      "locked": false
    },
    {
      "key": "hparam",
      "name": "하이퍼파라미터 변경",
      "desc": "config.yaml의 허용된 조작변인만",
      "defaults": {
        "manual": "ask",
        "error": "ask",
        "full": "allow"
      },
      "locked": false
    },
    {
      "key": "pkg",
      "name": "패키지 설치",
      "desc": "conda, pip",
      "defaults": {
        "manual": "ask",
        "error": "ask",
        "full": "ask"
      },
      "locked": false
    },
    {
      "key": "del",
      "name": "파일 삭제",
      "desc": "프로젝트 폴더 안",
      "defaults": {
        "manual": "ask",
        "error": "ask",
        "full": "ask"
      },
      "locked": false
    },
    {
      "key": "newexp",
      "name": "새 실험 시작",
      "desc": "작업 큐에 추가하고 실행",
      "defaults": {
        "manual": "ask",
        "error": "ask",
        "full": "allow"
      },
      "locked": false
    },
    {
      "key": "net",
      "name": "외부 네트워크 접근",
      "desc": "데이터셋·모델 다운로드 등",
      "defaults": {
        "manual": "ask",
        "error": "ask",
        "full": "ask"
      },
      "locked": false
    },
    {
      "key": "outside",
      "name": "프로젝트 폴더 밖 쓰기·삭제",
      "desc": "잠김 · 항상 차단",
      "defaults": {
        "manual": "block",
        "error": "block",
        "full": "block"
      },
      "locked": true
    },
    {
      "key": "stop",
      "name": "종료 조건·Evaluation.md 수정",
      "desc": "잠김 · 실험 진행 중 차단",
      "defaults": {
        "manual": "block",
        "error": "block",
        "full": "block"
      },
      "locked": true
    },
    {
      "key": "prev",
      "name": "이전 실험 폴더 덮어쓰기",
      "desc": "잠김 · 항상 차단",
      "defaults": {
        "manual": "block",
        "error": "block",
        "full": "block"
      },
      "locked": true
    }
  ],
  "locks": {
    "outside": "always",
    "prev": "always",
    "stop": "while-running"
  },
  "internalActions": {
    "journal": "allow",
    "selfProtect": "block",
    "hardProtect": "block",
    "secret": "block",
    "outputProtect": "block",
    "unknown": "defer"
  },
  "paths": {
    "stopLockedFiles": [
      "specifications/Config.yaml",
      "docs/Evaluation.md"
    ],
    "selfProtectedFiles": [
      ".claude/**",
      ".mcp.json",
      "logs/Approval_log.csv",
      "logs/hook_events.jsonl",
      "state/Current.yaml"
    ],
    "journalFiles": [
      "state/State.yaml",
      "logs/Experiment_log.csv",
      "logs/Decision_log.md",
      "logs/Failures.md",
      "README.md",
      "state/Install_request.json",
      "experiments/*/result.csv",
      "experiments/*/analysis.md"
    ],
    "hparamFiles": [
      "experiments/*/config.yaml"
    ],
    "experimentsDir": "experiments",
    "experimentIdRe": "^EXP-[0-9]{3}$",
    "prevAppendable": [
      "analysis.md"
    ],
    "prevMarkers": [
      "result.csv",
      "analysis.md"
    ],
    "outputDirs": [
      "output",
      "checkpoints"
    ],
    "outputDeleteOnly": [
      "result.csv",
      "*.log"
    ],
    "allowOutsideRead": true,
    "readAllowRoots": [],
    "secretFilesExtra": [],
    "cacheDir": "",
    "extraWritableRoots": []
  },
  "bash": {
    "escalateOnSubstitution": true,
    "denyCommands": [
      "claude",
      "shred",
      "mkfs",
      "labremote",
      "sqlite3",
      "systemctl",
      "systemd-run",
      "loginctl",
      "kill",
      "pkill",
      "killall",
      "bwrap",
      "unshare",
      "nsenter",
      "chroot",
      "setarch",
      "strace",
      "ltrace",
      "gdb",
      "docker",
      "podman",
      "at",
      "batch",
      "crontab"
    ],
    "gitRemoteAsNet": false,
    "allowExtra": [],
    "entrypoints": []
  },
  "headless": {
    "onAsk": "deny-with-reason",
    "notifyDiscord": true
  },
  "runner": {
    "injectTokens": []
  },
  "logPath": "logs/Approval_log.csv",
  "eventLogPath": "logs/hook_events.jsonl",
  "updatedAt": "",
  "updatedBy": "template"
}
